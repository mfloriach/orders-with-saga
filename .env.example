# Required (service refuses to boot without these)
APP_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
LEDGER_DSN=postgres://ledger:ledger@localhost:5433/ledger?sslmode=disable
REDIS_ADDR=localhost:6379
RABBITMQ_URL=amqp://app:app@localhost:5672/
# Optional (defaults shown)
PORT=8080
RATE_LIMIT=100
RATE_WINDOW_SEC=60
# SMTP (optional - email sending disabled if SMTP_HOST not set)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=pass
# SMTP_TLS=starttls
# SMTP_FROM=noreply@example.com
