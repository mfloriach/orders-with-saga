# Required (service refuses to boot without these)
DB_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
LEDGER_DSN=postgres://ledger:ledger@localhost:5433/ledger?sslmode=disable
REDIS_ADDR=localhost:6379
# Optional (defaults shown)
PORT=8080
# Reserved, not enforced yet
RATE_LIMIT=100
RATE_WINDOW_SEC=60
# Present in docker-compose.yml; not used by the API yet
# RABBITMQ_URL=amqp://app:app@localhost:5672/

# docker-compose service settings (defaults match the DSNs above — keep in sync)
APP_DB_USER=app
APP_DB_PASSWORD=app
APP_DB_NAME=app
APP_DB_PORT=5432
LEDGER_DB_USER=ledger
LEDGER_DB_PASSWORD=ledger
LEDGER_DB_NAME=ledger
LEDGER_DB_PORT=5433
REDIS_PORT=6379
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# SMTP (optional - email sending disabled if SMTP_HOST not set)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=pass
# SMTP_TLS=starttls
# SMTP_FROM=noreply@example.com
