#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

command -v gitleaks >/dev/null || {
  echo "pre-push: gitleaks is required (brew install gitleaks)" >&2
  exit 1
}

zero=0000000000000000000000000000000000000000
failed=0

if [ -t 0 ]; then
  # Run manually: scan the whole history.
  gitleaks git --redact --no-banner || failed=1
else
  # git push feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    if [ "$local_sha" = "$zero" ]; then
      continue # branch deletion
    fi
    if [ "$remote_sha" = "$zero" ]; then
      log_opts="$local_sha" # new branch: scan everything reachable
    else
      log_opts="$remote_sha..$local_sha"
    fi
    gitleaks git --redact --no-banner --log-opts="$log_opts" || failed=1
  done
fi

if [ "$failed" -ne 0 ]; then
  echo "pre-push: gitleaks found secrets; remove them or rotate the credentials." >&2
  exit 1
fi

make lint build test
