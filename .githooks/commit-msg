#!/usr/bin/env bash
set -euo pipefail

msg=$(head -n 1 "$1")

case "$msg" in
  Merge*|Revert*|fixup!*|squash!*|amend!*) exit 0 ;;
esac

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .+$'

if ! printf '%s' "$msg" | grep -Eq "$pattern"; then
  cat >&2 <<'EOF'
Invalid commit message. Expected:

  <type>(<scope>): <subject>

  type:  build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test
  scope: optional, e.g. feat(payment): ...

Example: fix(idempotency): reject reused key with different payload
EOF
  exit 1
fi

if [ "${#msg}" -gt 100 ]; then
  echo "Invalid commit message: header is ${#msg} chars, max is 100." >&2
  exit 1
fi
